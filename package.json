{
  "name": "portfolio-site",
  "version": "1.0.0",
  "private": true,
  "description": "Diwakar Yadav portfolio — main static site (diwakaryadav.com.np) + DiwakarOS (os.diwakaryadav.com.np).",
  "scripts": {
    "test:main": "node scripts/verify-main-site.mjs",
    "test:os": "npm --prefix portfolio-os run test",
